<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LittleBigMouse.Plugins.Avalonia.Localization;assembly=LittleBigMouse.Plugins.Avalonia"
        x:Class="LittleBigMouse.Ui.Avalonia.Controls.MonitorWarningDialog"
        Title="{loc:Tr Dialog.MonitorWarning.Detach.Title}"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Lbm.Brushes.Pane.Background}">

	<StackPanel Margin="24,20" Spacing="14">

		<StackPanel Orientation="Horizontal" Spacing="12">
			<Path Data="{StaticResource Lbm.Icon.Warning}"
			      Fill="#E0A030" Width="26" Height="26" Stretch="Uniform"
			      VerticalAlignment="Center"/>
			<TextBlock x:Name="HeadingText"
			           Text="{loc:Tr Dialog.MonitorWarning.Detach.Heading}"
			           FontSize="16" FontWeight="SemiBold"
			           Foreground="{DynamicResource Lbm.Brushes.Text.Primary}"
			           VerticalAlignment="Center" TextWrapping="Wrap"/>
		</StackPanel>

		<TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13"
		           Foreground="{DynamicResource Lbm.Brushes.Text.Primary}"
		           Text="{loc:Tr Dialog.MonitorWarning.Detach.Body}"/>

		<Border Background="{DynamicResource Lbm.Brushes.Card.Background}"
		        BorderBrush="{DynamicResource Lbm.Brushes.Card.Border}"
		        BorderThickness="1" CornerRadius="6" Padding="14,10">
			<StackPanel Spacing="6">
				<TextBlock x:Name="RecoveryTitle"
				           Text="{loc:Tr Dialog.MonitorWarning.Detach.RecoveryTitle}"
				           FontSize="13" FontWeight="SemiBold"
				           Foreground="{DynamicResource Lbm.Brushes.Text.Primary}"/>
				<TextBlock x:Name="Step1" TextWrapping="Wrap" FontSize="12"
				           Foreground="{DynamicResource Lbm.Brushes.Text.Secondary}"
				           Text="{loc:Tr Dialog.MonitorWarning.Detach.Step1}"/>
				<TextBlock x:Name="Step2" TextWrapping="Wrap" FontSize="12"
				           Foreground="{DynamicResource Lbm.Brushes.Text.Secondary}"
				           Text="{loc:Tr Dialog.MonitorWarning.Detach.Step2}"/>
				<TextBlock x:Name="Step3" TextWrapping="Wrap" FontSize="12"
				           Foreground="{DynamicResource Lbm.Brushes.Text.Secondary}"
				           Text="{loc:Tr Dialog.MonitorWarning.Detach.Step3}"/>
			</StackPanel>
		</Border>

		<CheckBox x:Name="DontShowAgainCheckBox" FontSize="13"
		          Foreground="{DynamicResource Lbm.Brushes.Text.Primary}"
		          Content="{loc:Tr Dialog.MonitorWarning.DontShowAgain}"/>

		<CheckBox x:Name="ScaleCheckBox" FontSize="13" IsVisible="False"
		          Foreground="{DynamicResource Lbm.Brushes.Text.Primary}"
		          Content="{loc:Tr Dialog.MonitorWarning.AdjustScale}"/>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button x:Name="CancelButton" IsDefault="True" IsCancel="True"
			        MinWidth="90" HorizontalContentAlignment="Center"
			        Click="OnCancelClick" Content="{loc:Tr Dialog.MonitorWarning.Cancel}"/>
			<Button x:Name="ConfirmButton"
			        MinWidth="90" HorizontalContentAlignment="Center"
			        Click="OnConfirmClick" Content="{loc:Tr Dialog.MonitorWarning.Detach.Confirm}"/>
		</StackPanel>

	</StackPanel>
</Window>
