Windows Registry Editor Version 5.00

; The registry twin of TestData/Persistence/v5.6-current (the C# JSON fixture of the
; same name), spelled the way RegistryLayoutStore writes: every value a REG_SZ string,
; numbers in the invariant culture, bools as "1"/"0". The layout key still carries the
; legacy Priority/PriorityUnhooked, as the JSON fixture does.

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse]
"Priority"="High"
"PriorityUnhooked"="Idle"
"HomeCinema"="0"
"Pinned"="1"
"AutoUpdate"="0"
"StartMinimized"="1"
"StartElevated"="0"
"DebugTools"="0"
"VcpControl"="1"
"ShowMonitorActionWarning"="0"
"BorderValues"="PerMonitor"
"RescueShortcut"="Ctrl+Alt+Shift+M"
"HideTrayIcon"="1"
"ExcludedDefaultsVersion"="2"

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\Layouts\TST1234_1920x1080]
