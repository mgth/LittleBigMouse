Windows Registry Editor Version 5.00

; The registry twin of TestData/Persistence/v5.2-pre-sections: before the move/drag
; split, each edge's resistance was a VALUE of BorderResistance (one number for any
; crossing), not a subkey. The model size is still the pre-5.4.1 oriented one (#507).

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse]
"Priority"="High"
"PriorityUnhooked"="Idle"
"HomeCinema"="0"
"Pinned"="1"
"AutoUpdate"="1"
"StartMinimized"="0"
"StartElevated"="0"
"DebugTools"="0"
"ShowMonitorActionWarning"="1"
"BorderValues"="PerModel"

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\Layouts\TST1234_1920x1080]
"AllowOverlaps"="0"
"AllowDiscontinuity"="0"
"Algorithm"="Strait"
"MaxTravelDistance"="200"
"LoopX"="0"
"LoopY"="0"
"Enabled"="1"
"AdjustPointer"="0"
"AdjustSpeed"="0"

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\Layouts\TST1234_1920x1080\PhysicalMonitors]

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\Layouts\TST1234_1920x1080\PhysicalMonitors\TST1234_0]
"XLocationInMm"="320.5"
"YLocationInMm"="-12"
"PhysicalRatioX"="1"
"PhysicalRatioY"="1"
"ActiveSource"="DISPLAY1"
"SerialNumber"="SN-0001"

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\Layouts\TST1234_1920x1080\PhysicalMonitors\TST1234_0\BorderResistance]
"Left"="20"
"Top"="0"
"Right"="20"
"Bottom"="0"

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\Layouts\TST1234_1920x1080\PhysicalMonitors\TST1234_0\DISPLAY1]
"PixelX"="0"
"PixelY"="0"
"PixelWidth"="1920"
"PixelHeight"="1080"
"Orientation"="0"
"DisplayName"="\\\\.\\DISPLAY1"
"Primary"="1"

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\monitors]

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\monitors\TST1234]
"PnpName"="Test Monitor 24"

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\monitors\TST1234\Borders]
"Left"="8"
"Top"="9"
"Right"="8"
"Bottom"="14"

[HKEY_CURRENT_USER\SOFTWARE\Mgth\LittleBigMouse\monitors\TST1234\Size]
"Width"="338"
"Height"="598"
