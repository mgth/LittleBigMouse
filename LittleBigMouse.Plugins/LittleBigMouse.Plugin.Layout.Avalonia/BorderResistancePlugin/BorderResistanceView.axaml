<UserControl
    x:Class="LittleBigMouse.Plugin.Layout.Avalonia.BorderResistancePlugin.BorderResistanceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:HLab.Base.Avalonia.Controls;assembly=HLab.Base.Avalonia"
    xmlns:converters="clr-namespace:HLab.Mvvm.Avalonia.Converters;assembly=HLab.Mvvm.Avalonia"
    xmlns:borderResistancePlugin="clr-namespace:LittleBigMouse.Plugin.Layout.Avalonia.BorderResistancePlugin"
    mc:Ignorable="d"
    d:DesignHeight="300" d:DesignWidth="300"
    x:Name="UserControl"

    ClipToBounds="False"

    x:DataType="borderResistancePlugin:BorderResistanceViewModel"
    >

	<UserControl.Resources>
		<converters:ScaleConverter x:Key="Scale" />
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="controls|DoubleBox">
			<Setter Property="Background" Value="{DynamicResource HLab.Brushes.Background}"/>
			<Setter Property="Decimals" Value="1"/>
		</Style>
	</UserControl.Styles>

	<Grid>

		<!-- Drawing bands, one per edge. Each spans its edge END TO END and the four
		     overlap in the corners; every strip then mitres itself so the corner
		     square is split along its diagonal (see BorderSideStrip.UpdateGeometry).
		     Insetting them instead would be simpler, but it would make each band
		     shorter than the edge it represents — and the millimetre scale is
		     derived from that length, so sections would drift and overshoot. -->
		<Grid>
			<borderResistancePlugin:BorderSideStrip
				HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="16"
				DataContext="{Binding Left}"/>

			<borderResistancePlugin:BorderSideStrip
				HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="16"
				DataContext="{Binding Top}"/>

			<borderResistancePlugin:BorderSideStrip
				HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="16"
				DataContext="{Binding Right}"/>

			<borderResistancePlugin:BorderSideStrip
				HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="16"
				DataContext="{Binding Bottom}"/>
		</Grid>

		<!-- Per-edge default resistance, unchanged: one number governing both modes
		     wherever no section covers the edge. -->
		<Grid Margin="22">
			<controls:DoubleBox
				HorizontalAlignment="Center" VerticalAlignment="Top"
				Height="24"
				PointerWheelChanged="OnMouseWheel"
				ToolTip.Tip="Top edge default resistance (mm)"
				Value="{Binding Path=Model.BorderResistance.Top.Value}"/>

			<controls:DoubleBox
				HorizontalAlignment="Left" VerticalAlignment="Center"
				Height="24"
				PointerWheelChanged="OnMouseWheel"
				ToolTip.Tip="Left edge default resistance (mm)"
				Value="{Binding Path=Model.BorderResistance.Left.Value}"/>

			<controls:DoubleBox
				HorizontalAlignment="Center" VerticalAlignment="Bottom"
				Height="24"
				PointerWheelChanged="OnMouseWheel"
				ToolTip.Tip="Bottom edge default resistance (mm)"
				Value="{Binding Path=Model.BorderResistance.Bottom.Value}"/>

			<controls:DoubleBox
				HorizontalAlignment="Right" VerticalAlignment="Center"
				Height="24"
				PointerWheelChanged="OnMouseWheel"
				ToolTip.Tip="Right edge default resistance (mm)"
				Value="{Binding Path=Model.BorderResistance.Right.Value}"/>
		</Grid>

		<!-- Editor for the selected section. Kept over the monitor rather than in a
		     side panel: it belongs next to the edge being edited. -->
		<Border
			IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
			HorizontalAlignment="Center" VerticalAlignment="Center"
			Background="{DynamicResource HLab.Brushes.Background}"
			BorderBrush="White" BorderThickness="1" CornerRadius="4"
			Padding="8" MinWidth="180">

			<StackPanel Spacing="6">

				<TextBlock Text="Section" FontWeight="Bold"/>

				<Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" >
					<TextBlock Grid.Row="0" Grid.Column="0" Text="Move" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<controls:DoubleBox Grid.Row="0" Grid.Column="1" Height="24"
					                    IsEnabled="{Binding !Selected.Model.MoveBlock}"
					                    Value="{Binding Selected.Model.Move}"/>
					<CheckBox Grid.Row="0" Grid.Column="2" Content="Block" Margin="8,0,0,0"
					          IsChecked="{Binding Selected.Model.MoveBlock}"/>

					<TextBlock Grid.Row="1" Grid.Column="0" Text="Drag" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<controls:DoubleBox Grid.Row="1" Grid.Column="1" Height="24"
					                    IsEnabled="{Binding !Selected.Model.DragBlock}"
					                    Value="{Binding Selected.Model.Drag}"/>
					<CheckBox Grid.Row="1" Grid.Column="2" Content="Block" Margin="8,0,0,0"
					          IsChecked="{Binding Selected.Model.DragBlock}"/>
				</Grid>

				<!-- A crossing is defined per source edge, so a symmetric passage has
				     to exist on both sides. Forgetting the other half is the easiest
				     way to get a border that opens one way by accident. -->
				<Button Content="Mirror to facing edge" HorizontalAlignment="Stretch"
				        Click="OnMirror"/>

				<Button Content="Delete section" HorizontalAlignment="Stretch"
				        Click="OnDelete"/>

				<TextBlock
					IsVisible="{Binding Selected.Side.IsFullyBlocked}"
					TextWrapping="Wrap" MaxWidth="200" Foreground="Orange"
					Text="This edge is fully blocked in both modes. Ctrl still forces a crossing on Windows and X11, but not on Wayland."/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
