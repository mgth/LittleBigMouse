<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:options="clr-namespace:LittleBigMouse.Ui.Avalonia.Options"
             xmlns:controls="clr-namespace:LittleBigMouse.Ui.Avalonia.Controls"
             xmlns:loc="clr-namespace:LittleBigMouse.Plugins.Avalonia.Localization;assembly=LittleBigMouse.Plugins.Avalonia"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="900"
             x:Class="LittleBigMouse.Ui.Avalonia.Options.LayoutOptions"
             x:DataType="options:LbmOptionsViewModel"
             Background="Transparent"
             >
	<Border Background="{DynamicResource Lbm.Brushes.Pane.Background}">
		<Grid RowDefinitions="Auto,Auto,*">

			<Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Lbm.Brushes.Card.Separator}" Padding="18,12">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Text="{loc:Tr Options.Title}" FontSize="15" FontWeight="SemiBold"
					           Foreground="{DynamicResource Lbm.Brushes.Text.Primary}"
					           VerticalAlignment="Center"/>
					<Border Grid.Column="1" Classes="Badge Success"
					        IsVisible="{Binding Model.Elevated, FallbackValue=false}"
					        ToolTip.Tip="{loc:Tr Options.Elevated.Tooltip}">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Path Data="{StaticResource Lbm.Icon.Shield}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
							<TextBlock Text="{loc:Tr Options.Elevated.Badge}" VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
				</Grid>
			</Border>

			<!-- Stays put while the rest scrolls, and gives up its explanation as soon as it
			     stops being what you are looking at — a line of thanks should not cost a
			     third of the panel for the whole visit. -->
			<Border Grid.Row="1" Classes="SettingCard PinnedCard"
			        Classes.Compact="{Binding #SettingsScroll.Offset, Converter={x:Static controls:ScrollConverters.IsScrolled}}"
			        Margin="16,10,16,0">
				<controls:SettingRow Icon="{StaticResource Lbm.Icon.Coffee}"
				                     Classes.Compact="{Binding #SettingsScroll.Offset, Converter={x:Static controls:ScrollConverters.IsScrolled}}"
				                     Header="{loc:Tr Options.Support.Header}"
				                     Description="{loc:Tr Options.Support.Description}">
					<Button Click="Kofi_OnClick" ToolTip.Tip="ko-fi.com/mgth">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Path Data="{StaticResource Lbm.Icon.Coffee}" Width="13" Height="13" Stretch="Uniform"
							      Fill="{DynamicResource Lbm.Brushes.Text.Primary}" VerticalAlignment="Center"/>
							<TextBlock Text="{loc:Tr Options.Support.Kofi}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</controls:SettingRow>
			</Border>

			<ScrollViewer Grid.Row="2" x:Name="SettingsScroll">
				<StackPanel Margin="16,2,16,18">

					<TextBlock Classes="SectionHeader" Text="{loc:Tr Options.Section.General}"/>

					<Border Classes="SettingCard">
						<controls:SettingRow Icon="{StaticResource Lbm.Icon.Language}"
						                     Header="{loc:Tr Options.Language.Header}"
						                     Description="{loc:Tr Options.Language.Description}">
							<ComboBox ItemsSource="{Binding LanguageList}"
							          SelectedItem="{Binding SelectedLanguage}">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock x:DataType="options:ListItem"
										           Text="{Binding Caption}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</controls:SettingRow>
					</Border>

					<Border Classes="SettingCard">
						<controls:SettingRow Icon="{StaticResource Lbm.Icon.Update}"
						                     Header="{loc:Tr Options.AutoUpdate.Header}"
						                     Description="{loc:Tr Options.AutoUpdate.Description}">
							<ToggleSwitch IsChecked="{Binding Model.AutoUpdate, FallbackValue=false, Mode=TwoWay}"/>
						</controls:SettingRow>
					</Border>

					<Border Classes="SettingCard">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Startup}"
							                     Header="{loc:Tr Options.LoadAtStartup.Header}"
							                     Description="{loc:Tr Options.LoadAtStartup.Description}">
								<ToggleSwitch IsChecked="{Binding Model.LoadAtStartup, FallbackValue=false, Mode=TwoWay}"/>
							</controls:SettingRow>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Classes="Sub"
							                     Header="{loc:Tr Options.StartMinimized.Header}">
								<ToggleSwitch IsChecked="{Binding Model.StartMinimized, FallbackValue=false, Mode=TwoWay}"/>
							</controls:SettingRow>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Classes="Sub"
							                     Header="{loc:Tr Options.HideTrayIcon.Header}"
							                     Description="{loc:Tr Options.HideTrayIcon.Description}">
								<ToggleSwitch IsChecked="{Binding Model.HideTrayIcon, FallbackValue=false, Mode=TwoWay}"/>
							</controls:SettingRow>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Classes="Sub"
							                     Header="{loc:Tr Options.BoundToAgent.Header}"
							                     Description="{loc:Tr Options.BoundToAgent.Description}">
								<ToggleSwitch IsChecked="{Binding Model.BoundToAgent, FallbackValue=false, Mode=TwoWay}"/>
							</controls:SettingRow>
						</StackPanel>
					</Border>

					<Border Classes="SettingCard">
						<controls:SettingRow Icon="{StaticResource Lbm.Icon.Shield}"
						                     Header="{loc:Tr Options.StartElevated.Header}"
						                     Description="{loc:Tr Options.StartElevated.Description}">
							<ToggleSwitch IsChecked="{Binding Model.StartElevated, FallbackValue=false, Mode=TwoWay}"/>
						</controls:SettingRow>
					</Border>

					<Border Classes="SettingCard">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Priority}"
							                     Header="{loc:Tr Options.Priority.Header}"
							                     Description="{loc:Tr Options.Priority.Description}"/>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Classes="Sub" Header="{loc:Tr Options.Priority.Active}">
								<ComboBox ItemsSource="{Binding PriorityList}"
								          SelectedItem="{Binding SelectedPriority}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock x:DataType="options:ListItem"
											           Text="{Binding Caption}"
											           ToolTip.Tip="{Binding Description}"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</controls:SettingRow>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Classes="Sub" Header="{loc:Tr Options.Priority.Inactive}">
								<ComboBox ItemsSource="{Binding PriorityList}"
								          SelectedItem="{Binding SelectedPriorityUnhooked}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock x:DataType="options:ListItem"
											           Text="{Binding Caption}"
											           ToolTip.Tip="{Binding Description}"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</controls:SettingRow>
						</StackPanel>
					</Border>

					<Border Classes="SettingCard">
						<controls:SettingRow Icon="{StaticResource Lbm.Icon.Vcp}"
						                     Header="{loc:Tr Options.VcpControl.Header}"
						                     Description="{loc:Tr Options.VcpControl.Description}">
							<ToggleSwitch IsChecked="{Binding Model.VcpControl, FallbackValue=false, Mode=TwoWay}"/>
						</controls:SettingRow>
					</Border>

					<!-- Sub-option of VCP control: only meaningful inside the VCP panel. -->
					<Border Classes="SettingCard" Margin="24,0,0,0"
					        IsVisible="{Binding Model.VcpControl, FallbackValue=false}">
						<controls:SettingRow Icon="{StaticResource Lbm.Icon.Experimental}"
						                     Header="{loc:Tr Options.Experimental.Header}"
						                     Description="{loc:Tr Options.Experimental.Description}">
							<ToggleSwitch IsChecked="{Binding Model.ExperimentalFeatures, FallbackValue=false, Mode=TwoWay}"/>
						</controls:SettingRow>
					</Border>

					<Border Classes="SettingCard">
						<controls:SettingRow Icon="{StaticResource Lbm.Icon.Debug}"
						                     Header="{loc:Tr Options.DebugTools.Header}"
						                     Description="{loc:Tr Options.DebugTools.Description}">
							<ToggleSwitch IsChecked="{Binding Model.DebugTools, FallbackValue=false, Mode=TwoWay}"/>
						</controls:SettingRow>
					</Border>

					<TextBlock Classes="SectionHeader" Text="{loc:Tr Options.Section.Mouse}"/>

					<Border Classes="SettingCard">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Algorithm}"
							                     Header="{loc:Tr Options.Algorithm.Header}"
							                     Description="{loc:Tr Options.Algorithm.Description}"/>
							<!-- AutoScrollToSelectedItem off: these lists hold two or three cards and are
							     visible whole, so scrolling to the selection buys nothing — but the request
							     travels up to the settings scroller, which then opens the panel part-way
							     down instead of at the top. -->
							<ListBox Classes="ChoiceCards" Margin="14,0,6,12" AutoScrollToSelectedItem="False"
							         ItemsSource="{Binding AlgorithmList}"
							         SelectedItem="{Binding SelectedAlgorithm}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel x:DataType="options:ListItem" Spacing="2">
											<TextBlock Text="{Binding Caption}" FontSize="13"
											           Foreground="{DynamicResource Lbm.Brushes.Text.Primary}"/>
											<TextBlock Text="{Binding Description}" FontSize="11"
											           Foreground="{DynamicResource Lbm.Brushes.Text.Secondary}"
											           TextWrapping="Wrap"/>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</StackPanel>
					</Border>

					<Border Classes="SettingCard">
						<controls:SettingRow Icon="{StaticResource Lbm.Icon.Ruler}"
						                     Header="{loc:Tr Options.MaxTravelDistance.Header}"
						                     Description="{loc:Tr Options.MaxTravelDistance.Description}">
							<NumericUpDown Minimum="{Binding Model.MinimalMaxTravelDistance, FallbackValue=0}"
							               Increment="10"
							               Value="{Binding Model.MaxTravelDistance, FallbackValue=200}"
							               ClipValueToMinMax="True"/>
						</controls:SettingRow>
					</Border>

					<Border Classes="SettingCard">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Gamepad}"
							                     Header="{loc:Tr Options.PauseInGames.Header}"
							                     Description="{loc:Tr Options.PauseInGames.Description}"
							                     ToolTip.Tip="{loc:Tr Options.PauseInGames.Tooltip}">
								<ToggleSwitch IsChecked="{Binding Model.FreelookEnabled, FallbackValue=true, Mode=TwoWay}"/>
							</controls:SettingRow>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Classes="Sub"
							                     Header="{loc:Tr Options.DetectionInterval.Header}"
							                     Description="{loc:Tr Options.DetectionInterval.Description}"
							                     ToolTip.Tip="{loc:Tr Options.DetectionInterval.Tooltip}"
							                     IsEnabled="{Binding Model.FreelookEnabled, FallbackValue=true}">
								<NumericUpDown Minimum="0" Maximum="1000" Increment="10"
								               Value="{Binding Model.FreelookCheckInterval, FallbackValue=100}"
								               ClipValueToMinMax="True"/>
							</controls:SettingRow>
						</StackPanel>
					</Border>

					<Border Classes="SettingCard">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.LoopH}"
							                     Header="{loc:Tr Options.LoopX.Header}"
							                     Description="{loc:Tr Options.LoopX.Description}"
							                     IsEnabled="{Binding Model.LoopAllowed, FallbackValue=false}">
								<ToggleSwitch IsChecked="{Binding Model.LoopX, FallbackValue=false, Mode=TwoWay}"/>
							</controls:SettingRow>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.LoopV}"
							                     Header="{loc:Tr Options.LoopY.Header}"
							                     IsEnabled="{Binding Model.LoopAllowed, FallbackValue=false}">
								<ToggleSwitch IsChecked="{Binding Model.LoopY, FallbackValue=false, Mode=TwoWay}"/>
							</controls:SettingRow>
						</StackPanel>
					</Border>

					<Border Classes="SettingCard">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Mouse}"
							                     Header="{loc:Tr Options.AdjustSpeed.Header}"
							                     Description="{loc:Tr Options.AdjustSpeed.Description}"
							                     IsEnabled="{Binding AdjustSpeedAllowed, FallbackValue=false}"
							                     ToolTip.Tip="{loc:Tr Options.AdjustSpeed.Tooltip}">
								<ToggleSwitch IsChecked="{Binding Model.AdjustSpeed, FallbackValue=false, Mode=TwoWay}"/>
							</controls:SettingRow>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Pointer}"
							                     Header="{loc:Tr Options.AdjustPointer.Header}"
							                     Description="{loc:Tr Options.AdjustPointer.Description}"
							                     IsEnabled="{Binding AdjustPointerAllowed, FallbackValue=false}"
							                     ToolTip.Tip="{loc:Tr Options.AdjustPointer.Tooltip}">
								<ToggleSwitch IsChecked="{Binding Model.AdjustPointer, Mode=TwoWay, FallbackValue=false}"/>
							</controls:SettingRow>
						</StackPanel>
					</Border>

					<Border Classes="SettingCard" IsVisible="{Binding TouchMouseIndependentSupported}">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Mouse}"
							                     Header="{loc:Tr Options.Touch.Independent.Header}"
							                     Description="{loc:Tr Options.Touch.Independent.Description}">
								<ToggleSwitch IsChecked="{Binding Model.TouchMouseIndependent, Mode=TwoWay, FallbackValue=false}"/>
							</controls:SettingRow>
							<StackPanel IsVisible="{Binding Model.TouchMouseIndependent, FallbackValue=false}">
								<Border Classes="SettingSeparator"/>
								<controls:SettingRow Classes="Sub"
								                     Header="{loc:Tr Options.Touch.Stylus.Header}"
								                     Description="{loc:Tr Options.Touch.Stylus.Description}">
									<ToggleSwitch IsChecked="{Binding Model.StylusMouseIndependent, Mode=TwoWay, FallbackValue=false}"/>
								</controls:SettingRow>
								<Border Classes="SettingSeparator"/>
								<controls:SettingRow Classes="Sub"
								                     Header="{loc:Tr Options.Touch.RestoreFocus.Header}"
								                     Description="{loc:Tr Options.Touch.RestoreFocus.Description}">
									<ToggleSwitch IsChecked="{Binding Model.RestoreKeyboardFocus, Mode=TwoWay, FallbackValue=false}"/>
								</controls:SettingRow>
								<StackPanel IsVisible="{Binding Model.RestoreKeyboardFocus, FallbackValue=false}">
									<Border Classes="SettingSeparator"/>
									<controls:SettingRow Classes="Sub"
									                     Header="{loc:Tr Options.Touch.RestoreOnMove.Header}"
									                     Description="{loc:Tr Options.Touch.RestoreOnMove.Description}">
										<ToggleSwitch IsChecked="{Binding Model.FocusRestoreOnMouseMove, Mode=TwoWay}"/>
									</controls:SettingRow>
									<Border Classes="SettingSeparator"/>
									<controls:SettingRow Classes="Sub"
									                     Header="{loc:Tr Options.Touch.FocusDelay.Header}"
									                     Description="{loc:Tr Options.Touch.FocusDelay.Description}"
									                     IsEnabled="{Binding !Model.FocusRestoreOnMouseMove}">
										<NumericUpDown Minimum="0" Maximum="5000" Increment="20" FormatString="0"
										               ClipValueToMinMax="True" Value="{Binding Model.FocusRestoreDelay, Mode=TwoWay}"/>
									</controls:SettingRow>
									<Border Classes="SettingSeparator"/>
									<StackPanel Margin="14,10,14,14" Spacing="6">
										<TextBlock Text="{loc:Tr Options.Touch.AppRules.Title}" FontWeight="SemiBold"/>
										<TextBlock Text="{loc:Tr Options.Touch.AppRules.Description}" TextWrapping="Wrap" FontSize="12"/>
										<TextBlock Text="{loc:Tr Options.Touch.AppRules.Keep}"/>
										<TextBox Text="{Binding Model.FocusKeepApps, Mode=TwoWay}"
										         PlaceholderText="chrome.exe; notepad.exe"/>
										<TextBlock Text="{loc:Tr Options.Touch.AppRules.Restore}"/>
										<TextBox Text="{Binding Model.FocusRestoreApps, Mode=TwoWay}"
										         PlaceholderText="{loc:Tr Options.Touch.AppRules.RestorePlaceholder}"/>
										<TextBlock Text="{loc:Tr Options.Touch.AppRules.Precedence}" TextWrapping="Wrap" FontSize="12"/>
									</StackPanel>
								</StackPanel>
								<Border Classes="SettingSeparator"/>
								<controls:SettingRow Classes="Sub"
								                     Header="{loc:Tr Options.Touch.AllDisplays.Header}"
								                     Description="{loc:Tr Options.Touch.AllDisplays.Description}">
									<ToggleSwitch IsChecked="{Binding Model.TouchAllDisplays, Mode=TwoWay}"/>
								</controls:SettingRow>
								<StackPanel IsVisible="{Binding !Model.TouchAllDisplays}" Margin="14,0,14,12" Spacing="6">
									<TextBlock Text="{loc:Tr Options.Touch.SelectDisplays}" TextWrapping="Wrap" FontSize="12"/>
									<ItemsControl ItemsSource="{Binding TouchDisplays}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="options:TouchDisplayChoice">
												<CheckBox IsChecked="{Binding Selected, Mode=TwoWay}">
													<TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
												</CheckBox>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
								<Border Classes="SettingSeparator"/>
								<controls:SettingRow Classes="Sub"
								                     Header="{loc:Tr Options.Touch.Override.Header}"
								                     Description="{loc:Tr Options.Touch.Override.Description}">
									<ComboBox ItemsSource="{Binding TouchModifierList}"
									          SelectedItem="{Binding SelectedTouchModifier}" MinWidth="100">
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<TextBlock x:DataType="options:ListItem" Text="{Binding Caption}"/>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
								</controls:SettingRow>
							</StackPanel>
						</StackPanel>
					</Border>

					<Border Classes="SettingCard" IsVisible="{Binding RescueShortcutSupported}">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Shield}"
							                     Header="{loc:Tr Options.RescueShortcut.Header}"
							                     Description="{loc:Tr Options.RescueShortcut.Description}">
								<controls:ShortcutBox Shortcut="{Binding Model.RescueShortcut, Mode=TwoWay, FallbackValue=''}"
								                      MinWidth="170" HorizontalAlignment="Right"/>
							</controls:SettingRow>
							<TextBlock Classes="SettingWarning"
							           Text="{Binding ShortcutWarning}"
							           IsVisible="{Binding ShortcutWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							<TextBlock Classes="SettingNote"
							           Text="{Binding ShortcutOwnership}"
							           IsVisible="{Binding ShortcutOwnership, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>
					</Border>

					<TextBlock Classes="SectionHeader" Text="{loc:Tr Options.Section.Layout}"/>

					<Border Classes="SettingCard">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Overlap}"
							                     Header="{loc:Tr Options.AllowOverlaps.Header}"
							                     Description="{loc:Tr Options.AllowOverlaps.Description}">
								<ToggleSwitch IsChecked="{Binding Model.AllowOverlaps, FallbackValue=false, Mode=TwoWay}"/>
							</controls:SettingRow>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Gap}"
							                     Header="{loc:Tr Options.AllowDiscontinuity.Header}"
							                     Description="{loc:Tr Options.AllowDiscontinuity.Description}">
								<ToggleSwitch IsChecked="{Binding Model.AllowDiscontinuity, FallbackValue=false, Mode=TwoWay}"/>
							</controls:SettingRow>
							<Border Classes="SettingSeparator"/>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Ruler}"
							                     Header="{loc:Tr Options.MinimalEdgeOverlap.Header}"
							                     Description="{loc:Tr Options.MinimalEdgeOverlap.Description}"
							                     ToolTip.Tip="{loc:Tr Options.MinimalEdgeOverlap.Tooltip}">
								<NumericUpDown Minimum="0" Increment="5"
								               Value="{Binding Model.MinimalEdgeOverlap, FallbackValue=20}"
								               ClipValueToMinMax="True"/>
							</controls:SettingRow>
						</StackPanel>
					</Border>

					<Border Classes="SettingCard">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Ruler}"
							                     Header="{loc:Tr Options.BorderValues.Header}"
							                     Description="{loc:Tr Options.BorderValues.Description}"/>
							<!-- AutoScrollToSelectedItem off: these lists hold two or three cards and are
							     visible whole, so scrolling to the selection buys nothing — but the request
							     travels up to the settings scroller, which then opens the panel part-way
							     down instead of at the top. -->
							<ListBox Classes="ChoiceCards" Margin="14,0,6,12" AutoScrollToSelectedItem="False"
							         ItemsSource="{Binding BorderValuesList}"
							         SelectedItem="{Binding SelectedBorderValues}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<StackPanel x:DataType="options:ListItem" Spacing="2">
											<TextBlock Text="{Binding Caption}" FontSize="13"
											           Foreground="{DynamicResource Lbm.Brushes.Text.Primary}"/>
											<TextBlock Text="{Binding Description}" FontSize="11"
											           Foreground="{DynamicResource Lbm.Brushes.Text.Secondary}"
											           TextWrapping="Wrap"/>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</StackPanel>
					</Border>

					<Border Classes="SettingCard">
						<controls:SettingRow Icon="{StaticResource Lbm.Icon.Warning}"
						                     Header="{loc:Tr Options.WarnMonitorActions.Header}"
						                     Description="{loc:Tr Options.WarnMonitorActions.Description}">
							<ToggleSwitch IsChecked="{Binding Model.ShowMonitorActionWarning, FallbackValue=true, Mode=TwoWay}"/>
						</controls:SettingRow>
					</Border>

					<TextBlock Classes="SectionHeader" Text="{loc:Tr Options.Section.Excluded}"/>

					<Border Classes="SettingCard">
						<StackPanel>
							<controls:SettingRow Icon="{StaticResource Lbm.Icon.Excluded}"
							                     Header="{loc:Tr Options.Excluded.Header}"
							                     Description="{loc:Tr Options.Excluded.Description}"/>

							<ListBox Classes="ProcessList"
							         ItemsSource="{Binding Model.ExcludedList}"
							         SelectedValue="{Binding SelectedExcludedProcess}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="*,Auto" Background="Transparent">
											<TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="13"/>
											<Button Grid.Column="1" Classes="IconButton"
											        Command="{Binding $parent[ListBox].((options:LbmOptionsViewModel)DataContext).RemoveExcludedProcessCommand}"
											        CommandParameter="{Binding}"
											        ToolTip.Tip="{loc:Tr Options.Excluded.RemoveTooltip}">
												<Path Data="{StaticResource Lbm.Icon.Trash}" Width="14" Height="14" Stretch="Uniform"/>
											</Button>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>

							<Grid ColumnDefinitions="*,Auto" Margin="14,6,14,12">
								<TextBox PlaceholderText="{loc:Tr Options.Excluded.Watermark}"
								         Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
								         FontSize="13"/>
								<Button Grid.Column="1" Margin="8,0,0,0"
								        Command="{Binding AddExcludedProcessCommand}"
								        Content="{loc:Tr Options.Excluded.ExcludeButton}"/>
							</Grid>

							<Button HorizontalAlignment="Left" Margin="14,0,14,12"
							        Command="{Binding AddDefaultsCommand}"
							        Content="{loc:Tr Options.Excluded.AddDefaults}"
							        ToolTip.Tip="{loc:Tr Options.Excluded.AddDefaultsTooltip}"/>

							<Border Classes="SettingSeparator"/>

							<controls:SettingRow Classes="Sub"
							                     Header="{loc:Tr Options.SeenProcesses.Header}"
							                     Description="{loc:Tr Options.SeenProcesses.Description}"/>
							<ListBox Classes="ProcessList"
							         ItemsSource="{Binding SeenProcesses}"
							         SelectedValue="{Binding SelectedSeenProcess}"
							         Margin="0,0,0,8">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Border Classes.match="{Binding Match}" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left">
											<Border.Styles>
												<Style Selector="Border.match">
													<Setter Property="Background" Value="{DynamicResource Lbm.Brushes.Accent.Faint}"/>
												</Style>
											</Border.Styles>
											<TextBlock x:DataType="options:SeenProcessViewModel"
											           Text="{Binding Caption}"
											           FontSize="13"
											           VerticalAlignment="Center"
											           ToolTip.Tip="{Binding Description}"/>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Border>
</UserControl>
